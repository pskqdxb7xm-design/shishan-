/* ============================================
   全局样式 —— 设计系统工具类
   品牌色: #FF6B35 (橙色)
   文字: #1a1a1a / #333333 / #6b7280 / #9ca3af
   背景: #FFF0E8 (浅橙) / #F8F9FA (浅灰)
   ============================================ */

/* ---- Reset ---- */
page {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  font-size: 16px;
  color: #333333;
  background-color: #ffffff;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* ---- Flex ---- */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-1 { flex: 1; }
.flex-shrink-0 { flex-shrink: 0; }
.items-center { align-items: center; }
.items-start { align-items: flex-start; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.justify-end { justify-content: flex-end; }
.flex-wrap { flex-wrap: wrap; }

/* ---- Gap ---- */
.gap-1 { gap: 4px; }
.gap-2 { gap: 8px; }
.gap-3 { gap: 12px; }
.gap-4 { gap: 16px; }

/* ---- Position ---- */
.relative { position: relative; }
.absolute { position: absolute; }

/* ---- Overflow & Text ---- */
.overflow-hidden { overflow: hidden; }
.whitespace-nowrap { white-space: nowrap; }
.text-center { text-align: center; }
.text-left { text-align: left; }

/* ---- Spacing ---- */
.p-2 { padding: 8px; }
.p-3 { padding: 12px; }
.p-4 { padding: 16px; }
.p-5 { padding: 20px; }
.px-3 { padding-left: 12px; padding-right: 12px; }
.px-4 { padding-left: 16px; padding-right: 16px; }
.px-5 { padding-left: 20px; padding-right: 20px; }
.py-2 { padding-top: 8px; padding-bottom: 8px; }
.py-4 { padding-top: 16px; padding-bottom: 16px; }
.py-5 { padding-top: 20px; padding-bottom: 20px; }
.pb-4 { padding-bottom: 16px; }
.pb-8 { padding-bottom: 32px; }
.pb-20 { padding-bottom: 80px; }
.pt-8 { padding-top: 32px; }
.mb-2 { margin-bottom: 8px; }
.mb-3 { margin-bottom: 12px; }
.mb-4 { margin-bottom: 16px; }
.mb-5 { margin-bottom: 20px; }
.mt-1 { margin-top: 4px; }
.mt-2 { margin-top: 8px; }
.mt-3 { margin-top: 12px; }
.mt-4 { margin-top: 16px; }

/* ---- Typography ---- */
.font-bold { font-weight: 700; }
.font-medium { font-weight: 500; }
.font-semibold { font-weight: 600; }
.text-xs { font-size: 12px; }
.text-sm { font-size: 13px; }
.text-base { font-size: 16px; }
.text-lg { font-size: 18px; }
.text-xl { font-size: 20px; }
.text-2xl { font-size: 24px; }

/* ---- Text Colors ---- */
.text-dark { color: #1a1a1a; }
.text-primary { color: #333333; }
.text-secondary { color: #6b7280; }
.text-muted { color: #9ca3af; }
.text-medium { color: #4b5563; }
.text-brand { color: #FF6B35; }
.text-white { color: #ffffff; }

/* ---- Backgrounds ---- */
.bg-white { background-color: #ffffff; }
.bg-brand { background-color: #FF6B35; }
.bg-brand-light { background-color: #FFF0E8; }
.bg-gray-light { background-color: #F8F9FA; }
.bg-gray { background-color: #f3f4f6; }

/* ---- Borders & Radius ---- */
.border { border: 1px solid #E5E5E5; }
.border-brand { border-color: #FF6B35; }
.rounded-full { border-radius: 9999px; }
.rounded-xl { border-radius: 12px; }
.rounded-lg { border-radius: 8px; }
.rounded-md { border-radius: 6px; }

/* ---- Shadows ---- */
.shadow-sm { box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05); }
.shadow-md { box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07); }

/* ---- Line Clamp (多行截断) ---- */
.line-clamp-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
