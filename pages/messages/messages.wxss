@import "../../app.wxss";

.page-container { min-height:100vh; background:#fff; }
.header { display:flex; align-items:center; justify-content:center; padding:0 20px 12px; border-bottom:1px solid rgba(229,229,229,0.5); }
.content-area { padding:16px; }
.loading-state { text-align:center; padding:80px 0; }
.empty-state { text-align:center; padding:80px 0; color:#9ca3af; font-size:14px; }

.notify-card { display:flex; gap:12px; padding:14px 12px; border-bottom:1px solid rgba(229,229,229,0.3); position:relative; }
.notify-card.unread { background:rgba(255,107,53,0.03); }
.notify-left { position:relative; flex-shrink:0; }
.notify-avatar { width:44px; height:44px; border-radius:50%; }
.notify-avatar-placeholder { background:#FFF0E8; }
.notify-avatar-pl { width:44px; height:44px; border-radius:50%; background:#FFF0E8; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.notify-avatar-txt { font-size:16px; font-weight:700; color:#FF6B35; }
.unread-dot { position:absolute; top:-2px; right:-2px; width:10px; height:10px; background:#FF3B30; border-radius:50%; border:2px solid #fff; }
.notify-body { flex:1; min-width:0; display:flex; flex-direction:column; gap:4px; }
.notify-top { display:flex; align-items:center; }
