.page { height:100vh; display:flex; flex-direction:column; background:#f8f9fa; position:relative; }
.head { display:flex; align-items:center; justify-content:space-between; padding:10px 16px; background:#fff; border-bottom:1px solid #f0f0f0; }
.head-back { font-size:18px; color:#6b7280; padding:4px 14px; background:#F3F4F6; border-radius:8px; font-weight:700; }
.head-title { font-size:17px; font-weight:700; }

.search-bar { padding:10px 16px; background:#fff; }
.search-input { width:100%; padding:10px 14px; background:#F3F4F6; border-radius:10px; font-size:15px; box-sizing:border-box; height:40px; }

.main-scroll { flex:1; height:0; padding:0 16px; }
.section { margin-top:16px; }
.section-label { font-size:12px; color:#9ca3af; font-weight:600; display:block; margin-bottom:8px; }
.locate-row { display:flex; align-items:center; justify-content:space-between; background:#fff; padding:14px; border-radius:10px; }
.locate-city { font-size:16px; font-weight:700; color:#FF6B35; }
.locate-refresh { font-size:12px; color:#9ca3af; }

.hot-grid { display:flex; flex-wrap:wrap; gap:8px; }
.hot-item { padding:8px 0; width:calc(33.33% - 6px); text-align:center; background:#fff; border-radius:8px; font-size:14px; color:#1a1a1a; }
.hot-item.active { background:#FFF0E8; color:#FF6B35; font-weight:600; }

.az-letter { padding:10px 0 4px; font-size:13px; font-weight:700; color:#FF6B35; background:#f8f9fa; }
.city-row { padding:14px 4px; background:#fff; font-size:15px; color:#1a1a1a; border-bottom:1px solid rgba(0,0,0,0.03); }
.city-row:active { background:#f0f0f0; }

.result-list { flex:1; padding:0 16px; }
.result-item { display:flex; align-items:center; justify-content:space-between; padding:14px 0; border-bottom:1px solid #f0f0f0; }
.pingyin { font-size:12px; color:#9ca3af; }

.index-bar { position:fixed; right:4px; top:50%; transform:translateY(-50%); display:flex; flex-direction:column; gap:1px; z-index:10; }
.index-item { width:20px; height:18px; display:flex; align-items:center; justify-content:center; font-size:11px; color:#FF6B35; font-weight:600; }
