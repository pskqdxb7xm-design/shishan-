/* pages/create/create.wxss */
@import "../../app.wxss";

.page-container {
  min-height: 100vh;
  background: #ffffff;
}

/* ---- Header ---- */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px 12px 20px;
  border-bottom: 1px solid rgba(229, 229, 229, 0.5);
}

.back-btn {
  padding: 8px 0;
  width: 48px;
}

/* ---- Section ---- */
.section {
  padding: 20px;
  border-bottom: 1px solid rgba(229, 229, 229, 0.3);
}

.label {
  display: block;
  font-size: 15px;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12px;
}

/* ---- Image Grid ---- */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.image-item {
  width: 100px;
  height: 100px;
  border-radius: 8px;
  position: relative;
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.img-remove {
  position: absolute;
  top: 4px;
  right: 4px;
  width: 22px;
  height: 22px;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.remove-text {
  color: #ffffff;
  font-size: 12px;
}

.img-progress {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.5);
  padding: 4px;
  text-align: center;
}

.progress-text {
  color: #ffffff;
  font-size: 10px;
}

.image-add {
  border: 2px dashed #E5E5E5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  background: #F8F9FA;
}

.add-icon {
  font-size: 28px;
  color: #9ca3af;
  line-height: 1;
}

/* ---- Form Input ---- */
.form-input {
  width: 100%;
  padding: 14px 16px;
  border: 1px solid #E5E5E5;
  border-radius: 8px;
  font-size: 16px;
  color: #1a1a1a;
  background: #F8F9FA;
  box-sizing: border-box;
  height: 50px;
  line-height: 22px;
}
.form-input:focus { border-color: #FF6B35; background: #ffffff; }

.form-textarea {
  width: 100%;
  padding: 14px 16px;
  border: 1px solid #E5E5E5;
  border-radius: 8px;
  font-size: 15px;
  color: #1a1a1a;
  background: #F8F9FA;
  box-sizing: border-box;
  min-height: 80px;
}
.form-textarea:focus { border-color: #FF6B35; background: #ffffff; }

.switch-row { display:flex; align-items:center; justify-content:space-between; }
.locate-tip { margin-top:6px; padding:8px 12px; background:#FFF0E8; color:#FF6B35; font-size:13px; border-radius:6px; text-align:center; }
.time-row { display:flex; gap:10px; }
.time-pick { flex:1; padding:12px 14px; border:1px solid #e5e5e5; border-radius:8px; font-size:15px; color:#1a1a1a; background:#F8F9FA; text-align:center; }
.time-show { display:block; margin-top:8px; font-size:14px; color:#FF6B35; font-weight:600; }
.city-picker { display:flex; align-items:center; justify-content:space-between; padding:14px 16px; border:1px solid #e5e5e5; border-radius:8px; background:#F8F9FA; }
.city-text { font-size:16px; color:#1a1a1a; }
.city-arrow { font-size:16px; color:#9ca3af; }
.gender-row { display:flex; gap:8px; }
.gender-btn { flex:1; text-align:center; padding:10px 0; border-radius:8px; background:#F3F4F6; font-size:13px; color:#6b7280; }
.gender-btn.active { background:#FFF0E8; color:#FF6B35; font-weight:700; border:1px solid #FF6B35; }
.agreement-row { display:flex; align-items:center; gap:4px; flex-wrap:wrap; }
.consent-box { width:18px; height:18px; border:2px solid #D1D5DB; border-radius:4px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.consent-box.checked { background:#FF6B35; border-color:#FF6B35; }
.consent-check { color:#fff; font-size:12px; }

/* ---- Category Select ---- */
.category-select {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.cat-option {
  padding: 8px 14px;
  border-radius: 9999px;
  font-size: 13px;
  font-weight: 500;
  border: 1px solid #E5E5E5;
  color: #4b5563;
  background: #ffffff;
}
.cat-option.active {
  background: #FFF0E8;
  color: #FF6B35;
  border-color: #FF6B35;
}

/* ---- Submit ---- */
.submit-area {
  padding: 24px 20px;
}

.submit-btn {
  width: 100%;
  padding: 14px;
  background: #FF6B35;
  color: #ffffff;
  font-size: 17px;
  font-weight: 700;
  border-radius: 12px;
  border: none;
  text-align: center;
}
.submit-btn.disabled {
  background: #ccc;
}
.submit-btn:active {
  opacity: 0.85;
}

.submit-btn[loading] {
  background: #ccc;
}
